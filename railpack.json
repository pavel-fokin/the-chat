{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "go": "1.26.5",
    "node": "22"
  },
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": [
        "...",
        { "src": "web", "dest": "web" },
        "npm --prefix web ci"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "deployOutputs": [{ "include": ["bin/the-chat-server"] }],
      "commands": [
        { "src": "cmd", "dest": "cmd" },
        { "src": "internal", "dest": "internal" },
        "npm --prefix web run build",
        "go build -o bin/the-chat-server ./cmd/the-chat-server"
      ]
    }
  },
  "deploy": {
    "startCommand": "./bin/the-chat-server"
  }
}
